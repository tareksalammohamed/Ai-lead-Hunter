VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional local demo auth; keep false/unset in production.
VITE_ALLOW_LOCAL_AUTH=false

# Server-side Supabase Edge Function secrets (set with `supabase secrets set`; never expose in VITE_ vars)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_OAUTH_SCOPES=openid profile email
META_APP_ID=
META_APP_SECRET=
META_OAUTH_SCOPES=public_profile,email,pages_show_list
SOURCE_CONNECTION_SECRET=
ALLOWED_ORIGINS=https://your-production-domain.example
